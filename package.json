{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio-ready UI and API test automation framework using Playwright, TypeScript, fixtures, POM and CI",
  "scripts": {
    "demo:start": "node demo-app/server.mjs",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:report": "playwright show-report",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:regression": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:server": "node --test tests/server/*.test.mjs",
    "test:e2e": "playwright test tests/ui",
    "test:accessibility": "playwright test --grep @accessibility",
    "dashboard:setup": "npm --prefix dashboard install --no-audit --no-fund",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:start": "node dashboard/server.mjs",
    "dashboard": "npm run dashboard:build && npm run dashboard:start",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "test:dashboard": "playwright test --config dashboard/playwright-dashboard.config.ts",
    "projects:validate": "node scripts/validate-projects.mjs",
    "project:run": "node scripts/run-project.mjs",
    "test:sample-api": "node scripts/run-project.mjs --project sample-api --environment local --suite all",
    "sample-web:start": "node projects/sample-web/server.mjs",
    "test:sample-web": "node scripts/run-project.mjs --project sample-web --environment local --suite all",
    "test:sample-api-staging": "node scripts/run-project.mjs --project sample-api --environment staging --suite api",
    "pilots:validate": "node scripts/pilot-audit.mjs",
    "project:onboard": "node scripts/onboard-project.mjs",
    "project:readiness": "node scripts/project-readiness.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "globals": "^16.4.0"
  }
}
