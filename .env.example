# Optional: override the bundled demo application's URL for a deployed compatible app.
# BASE_URL=https://your-app.example.com
# Default local demo server port (used only when starting the demo manually)
PORT=4173

# Module 5: explicit approval for an authorized, reviewed HTTPS staging host only.
# DO NOT set these unless you have permission to test that host. Never commit values.
# QA_REMOTE_APPROVAL=staging.your-company.example
# CLI requires --allow-remote as a second explicit gate.
# Service-specific login/API secrets belong in your terminal or untracked .env.local.
